# wa-webhook edge function secrets (set with: supabase secrets set KEY=value)
# NEVER commit real values. SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the platform.
WA_VERIFY_TOKEN=change-me-to-a-long-random-string
WA_APP_SECRET=your_meta_app_secret_here
WA_ACCESS_TOKEN=EAAG_your_system_user_token_here
